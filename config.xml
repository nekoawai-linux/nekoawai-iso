<?xml version="1.0" encoding="utf-8"?>
<image schemaversion="8.5" name="nekoawai-online-cli" displayname="NekoAwai Online CLI">
  <description type="system">
    <author>NekoAwai Project</author>
    <contact>https://nekoawai.moe</contact>
    <specification>NekoAwai online CLI Live and installation environment</specification>
  </description>
  <preferences>
    <!-- EFI only. The image used to boot on a legacy BIOS machine, carry the
         person all the way to nekoawai-install and then refuse: the installer
         is UEFI-only and says so at its first check. A medium that starts on
         hardware it cannot install on is a trap, and the honest fix is not to
         start.
         eficsm is what actually does it. Dropping gpt_hybrid_mbr and
         grub2-i386-pc is not enough on its own: KIWI writes a BIOS El Torito
         entry for an iso type regardless, and `make verify` catches that. -->
    <type image="iso" primary="true" filesystem="squashfs" flags="overlay"
          firmware="efi" eficsm="false" volid="NEKOAWAI_CLI_001"
          kernelcmdline="quiet loglevel=3">
      <bootloader name="grub2" timeout="3" timeout_style="menu"/>
    </type>
    <!-- Placeholder only. The distribution version is single-sourced in
         nekoawai-linux/nekoawai.conf (NEKO_VERSION) and stamped into the
         staged copy by scripts/build.sh. Do not edit this number. -->
    <version>0.0.0</version>
    <packagemanager>zypper</packagemanager>
    <locale>en_US</locale>
    <!-- Without a keytable the Live root gets no vconsole.conf at all and the
         console keeps whatever the firmware left behind. -->
    <keytable>us</keytable>
    <timezone>UTC</timezone>
    <!-- False because the distribution's own packages are unsigned, and this
         switch is not per repository: leaving it on would stop the build at
         the first nekoawai-* rpm. It costs the check on the Tumbleweed
         packages as well, which is the whole of what it costs.
         scripts/build.sh turns it on for the build the moment the target
         repository arrives signed; see nekoawai-linux, NEKO_SIGN_KEY. -->
    <rpm-check-signatures>false</rpm-check-signatures>
    <rpm-excludedocs>true</rpm-excludedocs>
  </preferences>
  <users>
    <user name="root" home="/root" shell="/bin/bash" groups="root"
          pwdformat="encrypted"
          password="$6$nekoawai$t.dTy4n.n7d5cpk3kECPVSafwkNBn6vPjt0HCJ9UXQZHtE38dNjLHMPA5E1PPry0nn57NP4yeOijUmY.p4Ekd1"/>
  </users>
  <repository type="rpm-md" alias="tumbleweed-oss" imageinclude="false">
    <source path="https://download.opensuse.org/tumbleweed/repo/oss/"/>
  </repository>
  <repository type="rpm-md" alias="nekoawai-target" priority="90" imageinclude="false">
    <source path="this://repositories/target"/>
  </repository>
  <repository type="rpm-md" alias="nekoawai-installer" priority="90" imageinclude="false">
    <source path="this://repositories/installer"/>
  </repository>
  <packages type="bootstrap">
    <package name="filesystem"/>
    <package name="glibc"/>
    <package name="bash"/>
    <package name="rpm"/>
    <package name="zypper"/>
    <package name="ca-certificates"/>
    <package name="ca-certificates-mozilla"/>
    <package name="nekoawai-release"/>
  </packages>
  <packages type="image" patternType="onlyRequired">
    <package name="patterns-nekoawai-base"/>
    <package name="nekoawai-install"/>
    <!-- The installer is a Python curses application. Both come in as its
         requires; naming them here means a change to the installer's
         dependencies cannot quietly leave the Live console without a working
         menu. curses is split out of python3-base on openSUSE. -->
    <package name="python3-base"/>
    <package name="python3-curses"/>
    <!-- The base pattern only recommends the firmware, and onlyRequired means
         a recommendation never arrives: the installer decides per machine
         whether the installed system keeps it. The medium has no such choice.
         It is an online installer, so it has to bring up a network card it has
         never seen before it can do anything at all, and a Live image without
         firmware is one that works in a virtual machine and nowhere else. -->
    <package name="kernel-firmware-all"/>
    <package name="grub2"/>
    <package name="grub2-x86_64-efi" arch="x86_64"/>
    <package name="grub2-branding-upstream"/>
  </packages>
  <packages type="iso">
    <package name="dracut-kiwi-live"/>
  </packages>
</image>
